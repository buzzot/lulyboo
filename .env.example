# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server-side only, never expose.
SUPABASE_SECRET_KEY=

# Admin login
ADMIN_PASSWORD=
# Long random string: openssl rand -hex 32
SESSION_SECRET=

# Public address used in supplier portal links (Railway sets RAILWAY_PUBLIC_DOMAIN automatically)
PUBLIC_URL=https://portal.lulyboo.com

# Email (verification codes + invitations) via Resend — https://resend.com
# Verify your domain in Resend, then set:
RESEND_API_KEY=
EMAIL_FROM=Lulyboo Supplier Portal <portal@lulyboo.com>
EMAIL_REPLY_TO=sourcing@lulyboo.com

# Claude API (optional, for AI review / similar / compare)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Send product thumbnails to the AI (true/false)
AI_INCLUDE_IMAGES=true

# Supabase plan storage in GB, for the usage meter (Free = 1, Pro = 100)
STORAGE_PLAN_GB=100
# Max upload per form submit (MB) and longest image side kept (px)
MAX_UPLOAD_MB=80
IMAGE_MAX_PX=1600
