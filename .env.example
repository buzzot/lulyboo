# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server-side only, never expose.
SUPABASE_SECRET_KEY=

# Admin login
ADMIN_PASSWORD=
# Long random string: openssl rand -hex 32
SESSION_SECRET=

# Public address used in supplier portal links (Railway sets RAILWAY_PUBLIC_DOMAIN automatically)
PUBLIC_URL=https://portal.lulyboo.com

# Email (verification codes + invitations) via Resend — https://resend.com
# Verify your domain in Resend, then set:
RESEND_API_KEY=
EMAIL_FROM=Lulyboo Supplier Portal <portal@lulyboo.com>
EMAIL_REPLY_TO=sourcing@lulyboo.com
# Testing only: write emails (incl. codes) to the server log when RESEND_API_KEY is not set. Never in production.
# EMAIL_DEV_LOG=true

# Claude API (optional, for AI review / similar / compare)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Send product thumbnails to the AI (true/false)
AI_INCLUDE_IMAGES=true

# Supabase plan storage in GB, for the usage meter (Free = 1, Pro = 100)
STORAGE_PLAN_GB=100
# Max upload per form submit (MB) and longest image side kept (px)
MAX_UPLOAD_MB=80
IMAGE_MAX_PX=1600

# Sample tracking (carrier APIs). Any you leave empty is simply not tracked automatically.
DHL_API_KEY=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ENV=production
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ENV=production

# Development threads by email: one mailbox, threads matched by the code in the subject, e.g. [Lulyboo DP-1001-9D6A]
DEV_EMAIL=projects@in.lulyboo.space

# Sailing schedules: free DCSA Commercial Schedules APIs, one block per carrier (SCAC: CMDU, MAEU, MSCU, HLCU, ONEY, ZIMU)
# DCSA_CMDU_URL=https://<carrier api host>/…/point-to-point-routes
# DCSA_CMDU_KEY=
# DCSA_CMDU_KEY_HEADER=API-Key          # header the carrier expects for the key
# or OAuth: DCSA_CMDU_TOKEN_URL= DCSA_CMDU_CLIENT_ID= DCSA_CMDU_CLIENT_SECRET=
# Maersk Point-to-Point Schedules (developer.maersk.com → My Apps → Consumer Key)
# MAERSK_CONSUMER_KEY=
